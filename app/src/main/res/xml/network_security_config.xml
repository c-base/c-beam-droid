<?xml version="1.0" encoding="utf-8"?>
<!--
  Replaces the app-wide android:usesCleartextTraffic="true". Cleartext is denied
  by default and re-enabled only for the three hosts that serve plain HTTP.

  No custom trust anchors: every c-base host is served by Let's Encrypt, and
  minSdkVersion is 25, so the root of that chain is in the system store on every
  device the app supports.
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Matelight, megablast and hyperblast speak plain HTTP only, and are
         reachable only on the c-base LAN. c-beam itself is listed so the URL
         override in the debug settings can point the app at a development
         instance that serves plain HTTP on a non-standard port; the default URL
         stays https and is unaffected by this entry. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">c-beam.cbrp3.c-base.org</domain>
        <domain includeSubdomains="false">matelight.cbrp3.c-base.org</domain>
        <domain includeSubdomains="false">10.0.1.23</domain>
        <domain includeSubdomains="false">10.0.1.24</domain>
    </domain-config>

</network-security-config>

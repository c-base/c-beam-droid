<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
                  android:layout_width="match_parent"
                  android:layout_height="match_parent"
                  android:orientation="vertical" >

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:title=""
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

        <!--
             Here is where we put the SurfaceView, in a frame so that we can
             stack other views on top of it.
        -->

        <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" >

            <android.view.SurfaceView
                    android:id="@+id/surfaceview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            <android.opengl.GLSurfaceView
                    android:id="@+id/glsurfaceview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            <android.view.View
                    android:id="@+id/scanbar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            <android.view.View
                    android:id="@+id/grid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            <RelativeLayout
                    android:id="@+id/outercontainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="visible" >

                <LinearLayout
                        android:id="@+id/hidecontainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_alignParentBottom="true"
                        android:background="#B0000000"
                        android:padding="2dp">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:orientation="horizontal">
                        <ToggleButton
                                android:id="@+id/hideme1"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/button"
                                android:textOff="scanner activieren"
                                android:textOn="scanner deactivieren"
                                android:textSize="12sp" />
                        <ToggleButton
                                android:id="@+id/hideme6"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/button"
                                android:checked="true"
                                android:textOff="cam activieren"
                                android:textOn="cam deactivieren"
                                android:textSize="12sp" />
                        <ToggleButton
                                android:id="@+id/hideme4"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/button"
                                android:checked="true"
                                android:textOff="filt0r activieren"
                                android:textOn="filt0r deactivieren"
                                android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:orientation="horizontal">
                        <Button
                                android:id="@+id/hideme3"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/button"
                                android:text="photonen abfeuern"
                                android:textSize="12sp" />
                        <ToggleButton
                                android:id="@+id/hideme5"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/button"
                                android:textOff="sensoren activieren"
                                android:textOn="sensoren deactivieren"
                                android:textSize="12sp" />
                        <ToggleButton
                                android:id="@+id/hideme2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/button"
                                android:textOff="grid activieren"
                                android:textOn="grid deactivieren"
                                android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                            android:id="@+id/textView1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:background="@drawable/button_32x32_med"
                            android:textColor="#FFFF00"
                            android:visibility="gone"/>
                    <TextView
                            android:id="@+id/textView2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:background="@drawable/button_32x32_med"
                            android:textColor="#FFFF00"
                            android:visibility="gone"/>

                </LinearLayout>

                <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:id="@+id/sensorPlotLayout"
                        android:layout_above="@+id/hidecontainer"
                        android:visibility="invisible">

                    <com.androidplot.xy.XYPlot
                            android:id="@+id/mySimpleXYPlot"
                            android:layout_width="fill_parent"
                            android:layout_height="0dp"
                            android:alpha="0.5"
                            android:layout_weight="1" />

                    <com.androidplot.xy.XYPlot
                            android:id="@+id/mySimpleXYPlot2"
                            android:layout_width="fill_parent"
                            android:layout_height="0dp"
                            android:alpha="0.5"
                            android:layout_weight="1"/>

                    <com.androidplot.xy.XYPlot
                            android:id="@+id/mySimpleXYPlot3"
                            android:layout_width="fill_parent"
                            android:layout_height="0dp"
                            android:alpha="0.5"
                            android:layout_alignParentLeft="true"
                            android:layout_weight="1"/>

                    <com.androidplot.xy.XYPlot
                            android:id="@+id/mySimpleXYPlot4"
                            android:layout_width="fill_parent"
                            android:layout_height="0dp"
                            android:alpha="0.5"
                            android:layout_alignParentLeft="true"
                            android:layout_weight="1"/>

                    <com.androidplot.xy.XYPlot
                            android:id="@+id/mySimpleXYPlot5"
                            android:layout_width="fill_parent"
                            android:layout_height="0dp"
                            android:alpha="0.5"
                            android:layout_alignParentLeft="true"
                            android:layout_weight="1"/>

                    <com.androidplot.xy.XYPlot
                            android:id="@+id/mySimpleXYPlot6"
                            android:layout_width="fill_parent"
                            android:layout_height="0dp"
                            android:alpha="0.5"
                            android:layout_alignParentLeft="true"
                            android:layout_weight="1"/>
                </LinearLayout>

                <!-- Hold-to-talk: transcript card, recording banner with level meter, and the
                     round microphone button. Sits above the c-ontrols when they are shown and
                     at the bottom edge otherwise. Hidden outside the crew network. -->
                <LinearLayout
                        android:id="@+id/voice_panel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_above="@id/hidecontainer"
                        android:layout_alignWithParentIfMissing="true"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:visibility="gone">

                    <!-- A small terminal in the style of the activity log: what was heard
                         appears after the prompt, what c-beam answered or did below it, and,
                         for anything audible in the station, the confirmation row. -->
                    <LinearLayout
                            android:id="@+id/voice_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="#000000"
                            android:orientation="vertical"
                            android:padding="4dp"
                            android:visibility="gone">

                        <TextView
                                android:id="@+id/voice_terminal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textColor="#3AB6E4"
                                android:textSize="10sp" />

                        <LinearLayout
                                android:id="@+id/voice_confirm"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal"
                                android:visibility="gone">

                            <Button
                                    android:id="@+id/voice_confirm_no"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@drawable/button"
                                    android:text="@string/voice_confirm_no"
                                    android:textColor="#FFFFFF" />

                            <Button
                                    android:id="@+id/voice_confirm_yes"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/button"
                                    android:text="@string/voice_confirm_yes"
                                    android:textColor="#33B6F6"
                                    android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical|end"
                            android:orientation="horizontal">

                        <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:orientation="vertical">

                            <TextView
                                    android:id="@+id/voice_status"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="#DDCC0000"
                                    android:padding="8dp"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />

                            <ProgressBar
                                    android:id="@+id/voice_level"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="6dp"
                                    android:layout_marginTop="4dp"
                                    android:max="100"
                                    android:progressTint="#FF3333"
                                    android:progressBackgroundTint="#66000000"
                                    android:visibility="gone" />
                        </LinearLayout>

                        <ImageButton
                                android:id="@+id/voice_button"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:background="@drawable/voice_button_bg"
                                android:contentDescription="@string/voice_hold_hint"
                                android:scaleType="center"
                                android:src="@drawable/ic_mic" />
                    </LinearLayout>
                </LinearLayout>

            </RelativeLayout>
        </FrameLayout>

        <RelativeLayout
                android:id="@+id/RelativeLayout1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" >

            <ToggleButton
                    android:id="@+id/vis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/button_show_controls"
                    android:textOff="c-ontrols anzeigen"
                    android:textOn="c-ontrols ausblenden" />

        </RelativeLayout>

    </LinearLayout>

    <!-- The navigation drawer -->
    <ListView android:id="@+id/left_drawer"
              android:layout_width="240dp"
              android:layout_height="match_parent"
              android:layout_gravity="start"
              android:choiceMode="singleChoice"
              android:divider="@android:color/transparent"
              android:dividerHeight="0dp"
              android:background="#111"/>

</androidx.drawerlayout.widget.DrawerLayout>